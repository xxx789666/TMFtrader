# 複製為 .env.sync 填入 VPS 連線資訊（.env.sync 在 .gitignore 內，安全）
#
# 取得 VPS 外部 IP：GCP Console → VM 執行個體 → ultratrader-night → 外部 IP
# 或：gcloud compute instances describe ultratrader-night --zone=asia-east1-b --format="value(networkInterfaces[0].accessConfigs[0].natIP)"

VPS_HOST=root@34.x.x.x
VPS_PROJECT_DIR=/root/ultra-trader-src
LOCAL_PROJECT_DIR=$HOME/vps_trader/ultra-trader-src

# SSH key 路徑（在 WSL2 內生成、用 gcloud compute os-login ssh-keys add 上傳到 GCP）
SSH_KEY=$HOME/.ssh/id_ed25519

# 拉回近 N 天的 daily JSON
SYNC_DAYS=14

# TG 通知（沿用既有 EA 的 bot）
TG_BOT_TOKEN=
TG_CHAT_ID=
